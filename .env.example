# 复制成 .env 再改(cp .env.example .env)。
# .env 里有 NAS 密码,别提交到 git。

# ── 端口 ────────────────────────────────────────────────────
# 浏览器开这个
WEB_PORT=5106

# ── 管理页密码 ───────────────────────────────────────────────
# 留空 = 进管理页不用密码。只在自己局域网里用可以先留空,
# 但暴露到公网前一定要设一个(也能在「管理 › 通用 › 密码」里现设)。
YU_ADMIN_PASSWORD=

# ── 让下载的无损文件落在群晖上(可选)─────────────────────────
# 两种协议二选一,SMB 优先(同局域网和不在局域网都能用)。
#
# NFS:跟 NAS 在同一个局域网时用。群晖那边要先 export 这个目录
#     (控制面板 → 共享文件夹 → 编辑 → NFS 权限)。
#     例:MEDIA_NFS=192.168.1.28:/volume1/music/YuMusic
MEDIA_NFS=

# SMB:人在外面、跟 NAS 不在同一个局域网时用。
#     DSM 的网页端口只监听 IPv4,人在外面时 WebDAV 那条路走不通;
#     但 SMB 监听 IPv6,群晖的 QuickConnect 域名正好解析到它当前的 IPv6。
#     域名从 DSM「控制面板 → 登录门户 → 快速连接」拿。
#     例:MEDIA_SMB=//syn6-xxxxxxxxxxxxxxxx.yucore.direct.quickconnect.cn/music
MEDIA_SMB=
MEDIA_SMB_USER=
MEDIA_SMB_PASS=
# 共享文件夹里真正的缓存目录(共享根下还有别的音乐文件夹时填)
MEDIA_SMB_SUBDIR=
